<Window x:Class="WetterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WetterApp"
        mc:Ignorable="d"
        Title="Wetter App" Height="450" Width="800"
        Loaded="Window_Loaded">
    <TabControl SelectionChanged="TabControl_SelectionChanged">
        <TabItem Header="Weather requester">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            Grid.Column="1">
                    <Label Content="Longitude" 
                           VerticalAlignment="Center"/>
                    <TextBox Name="TextBlock_Longitude"                      
                             Text="9,2"                  
                             VerticalAlignment="Center"
                             PreviewTextInput="TextBlock_Longitude_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal">
                    <Label Content="Laditude" 
                           VerticalAlignment="Center"/>
                    <TextBox Name="TextBlock_Laditude"
                             Text="48,0"
                             VerticalAlignment="Center"
                             PreviewTextInput="TextBlock_Longitude_PreviewTextInput"/>
                </StackPanel>
                <Button Grid.Column="2" 
                        Height="25"
                        Width="100"
                        Content="Recieve data"
                        Click="Button_Click"/>
                <DataGrid Name="DataGridTemperatures" 
                          Grid.Row="1"
                          Grid.ColumnSpan="3"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp"
                                            Binding="{Binding Time}"/>
                        <DataGridTextColumn Header="Temperature in °C"
                                            Binding="{Binding Temperatur}"/>
                        <DataGridTextColumn Header="Wind speed in km/h"
                                            Binding="{Binding WindSpeed}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Save Data"
                        Margin="0,0,10,0"
                        Click="ButtonSaveData_Click"
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Height="25"
                        Width="100"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="TabItemPreviousRuns" 
                 Header="Previous runs">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="MessungGrid"
                          Margin="10"
                          Grid.Column="0"
                          ItemsSource="{Binding Messungen}"
                          AutoGenerateColumns="False"
                          SelectionChanged="MessungGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" />
                        <DataGridTextColumn Header="Longitude" Binding="{Binding Longitude}" />
                        <DataGridTextColumn Header="Latitude" 
                                            Binding="{Binding Latitude}" 
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="WetterwertGrid"
                          Margin="10"
                          Grid.ColumnSpan="2"
                          Grid.Column="1"
                          ItemsSource="{Binding Wetterwerte}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Uhrzeit" Binding="{Binding Uhrzeit}" />
                        <DataGridTextColumn Header="Temperatur (°C)" Binding="{Binding Temperatur}" />
                        <DataGridTextColumn Header="Windstärke (km/h)" 
                                            Binding="{Binding Windstaerke}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Delete"
                        Margin="0,0,10,0"
                        Grid.Row="1"
                        Grid.Column="2"
                        Height="25"
                        Width="100"
                        HorizontalAlignment="Right"                        
                        Click="ButtonDelete_Click"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
