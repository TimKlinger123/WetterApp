<Window x:Class="WetterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WetterApp"
        mc:Ignorable="d"
        Title="Wetter App" Height="450" Width="820"
        Loaded="Window_Loaded"
        WindowStyle="None"
        Background="#1E2A38"
        Foreground="#3A4F66">
    <Grid>
        <TabControl SelectionChanged="TabControl_SelectionChanged"
                    MouseLeftButtonDown="TabControl_MouseLeftButtonDown">
            <TabItem Header="Weather requester">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">
                        <Label Content="Laditude" 
                           VerticalAlignment="Center"/>
                        <TextBox Name="TextBlock_Laditude"
                             Text="48,0"
                             VerticalAlignment="Center"
                             PreviewTextInput="TextBlock_Longitude_PreviewTextInput"/>
                        <Label Content="Longitude" 
                               VerticalAlignment="Center"/>
                        <TextBox Name="TextBlock_Longitude"                      
                                 Text="9,2"                  
                                 VerticalAlignment="Center"
                                 PreviewTextInput="TextBlock_Longitude_PreviewTextInput"/>
                        <Label Content="CityName" 
                            VerticalAlignment="Center"/>
                        <TextBox Name="TextBlock_CityName"
                             Text="Stuttgart, Germany"
                             Width="130"
                             VerticalAlignment="Center"/>
                        <Button Content="Add"
                            Margin="5,0,0,0"
                            Height="25"
                            Click="ButtonAddCity_Click"/>
                        <ComboBox x:Name="CityComboBox"
                              Margin="10,0,0,0"
                              Height="22"
                              Width="150"
                              SelectionChanged="CityComboBox_SelectionChanged"
                              SelectedIndex="1">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" 
                                               Margin="0,0,5,0"
                                               MouseDown="CityItem_MouseDown"/>
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Löschen"
                                                      Click="MenuItemCity_Löschen_Click"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="2" 
                        HorizontalAlignment="Right"
                        Height="25"
                        Width="100"
                        Content="Recieve data"
                        Click="ButtonRecieveData_Click"/>
                    <DataGrid Name="DataGridTemperatures" 
                          Grid.Row="1"
                          Grid.ColumnSpan="3"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp"
                                            Binding="{Binding Time}"
                                            Width="0.2*"
                                            ElementStyle="{StaticResource ZentrierterZellenstil}"/>
                            <DataGridTextColumn Header="Temperature in °C"
                                            Binding="{Binding Temperatur}"
                                            Width="0.2*"
                                            ElementStyle="{StaticResource ZentrierterZellenstil}"/>
                            <DataGridTextColumn Header="Wind speed in km/h"
                                            Binding="{Binding WindSpeed}"
                                            Width="0.6*"
                                            ElementStyle="{StaticResource ZentrierterZellenstil}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal"
                            Grid.Row="2"
                            Grid.ColumnSpan="2">
                        <Label Content="MinTemp:" 
                           VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextBlock_MinTemp"
                               VerticalAlignment="Center"
                               Width="35"/>
                        <Label Content="MaxTemp:" 
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
                        <TextBlock Width="35"
                               x:Name="TextBlock_MaxTemp"
                               VerticalAlignment="Center"/>
                        <Label Content="AverageTemp:" 
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
                        <TextBlock Width="35"
                               x:Name="TextBlock_AverageTemp"
                               VerticalAlignment="Center"/>
                        <Label Content="MaxWindSpeed:" 
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
                        <TextBlock Width="60"
                               x:Name="TextBlock_MaxWindSpeed"
                               VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Save Data"
                        Margin="0,0,10,0"
                        Click="ButtonSaveData_Click"
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Height="25"
                        Width="100"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabItemPreviousRuns" 
                 Header="Previous runs">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="MessungGrid"
                          Margin="10"
                          Grid.Column="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="MessungGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" />
                            <DataGridTextColumn Header="Longitude" Binding="{Binding Longitude}" />
                            <DataGridTextColumn Header="Latitude" 
                                            Binding="{Binding Latitude}" 
                                            Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="WetterwertGrid"
                          Margin="10"
                          Grid.ColumnSpan="2"
                          Grid.Column="1"
                          ItemsSource="{Binding Wetterwerte}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Uhrzeit" Binding="{Binding Uhrzeit}" />
                            <DataGridTextColumn Header="Temperatur (°C)" Binding="{Binding Temperatur}" />
                            <DataGridTextColumn Header="Windstärke (km/h)" 
                                            Binding="{Binding Windstaerke}"
                                            Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Delete"
                        Margin="0,0,10,0"
                        Grid.Row="1"
                        Grid.Column="2"
                        Height="25"
                        Width="100"
                        HorizontalAlignment="Right"                        
                        Click="ButtonDelete_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Button Content="X"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Height="19"
                Width="19"
                FontSize="10"
                Click="ButtonClose_Click"/>
    </Grid>
</Window>
